# ============ LLM provider (pick ONE) ============

# --- Option A: Claude (best quality for this tool-heavy agent; paid) ---
# https://console.anthropic.com — needs credits
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Option B: FREE OpenAI-compatible providers (great for development) ---
# Uncomment one preset and add its key. Auto-selected when ANTHROPIC_API_KEY
# is empty (or force with LLM_PROVIDER=openai).

# B1. Google Gemini — free tier, has VISION (needed for photo features) + tools
#     Key: https://aistudio.google.com/apikey
#     NOTE: gemini-2.5-flash 404s for new accounts — use gemini-3.5-flash (or
#     gemini-flash-latest). List what your key can use:
#     curl -H "Authorization: Bearer $KEY" https://generativelanguage.googleapis.com/v1beta/openai/models
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL=gemini-3.5-flash

# B2. Groq — free dev tier, very fast (Llama models; use a vision-capable one
#     like meta-llama/llama-4-scout-17b-16e-instruct if you need photos)
#     Key: https://console.groq.com/keys
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile

# B3. OpenRouter — free-tier models (rate-limited), one key for many models
#     Key: https://openrouter.ai/keys
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=google/gemini-2.0-flash-exp:free

# Force the provider instead of auto-detection: anthropic | openai
# LLM_PROVIDER=

# ============ Swiggy backend ============

# mock: built-in simulator of Swiggy's MCP servers (no Swiggy account needed)
# real: talk to Swiggy's MCP servers with the user's OAuth token
SWIGGY_MODE=mock

# Real-mode server URLs (defaults shown; point at staging while in Builders Club onboarding)
# SWIGGY_FOOD_URL=https://mcp.swiggy.com/food
# SWIGGY_IM_URL=https://mcp.swiggy.com/im
# SWIGGY_DINEOUT_URL=https://mcp.swiggy.com/dineout

# Real-mode OAuth (issued during Swiggy Builders Club onboarding, after our
# redirect URI is whitelisted)
# SWIGGY_OAUTH_CLIENT_ID=
# SWIGGY_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/swiggy/callback

# Override tool names after running `npm run discover-tools` against staging,
# e.g. {"food_search_restaurants":"restaurant_search"}
# SWIGGY_TOOLMAP_JSON=
